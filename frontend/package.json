{
  "name": "diary_assistant",
  "version": "1.0.0",
  "description": "",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "vite": "^5.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "typescript": "^5.4.5",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "electron-builder": "^24.13.3",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5"
  },
  "build": {
    "appId": "com.diary.assistant",
    "productName": "DiaryAs",
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "target": "dir"
    },
    "extraResources": [
      {
        "from": "extraResources",
        "to": "extraResources",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}